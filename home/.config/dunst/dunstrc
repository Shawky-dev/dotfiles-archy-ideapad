[global]
width = 300
offset = 5x40
follow = mouse
progress_bar_min_width = 80
progress_bar_max_width = 280
progress_bar_corner_radius = 2
alignment = left
padding = 12
horizontal_padding = 14
frame_width = 2
gap_size = 4
font = "Iosevka Nerd Font 12"

# rose-pine-icons was never installed; breeze comes from setup.sh
icon_theme = "breeze-dark, hicolor"
enable_recursive_icon_lookup = true
max_icon_size = 32
# Same corners as picom windows and the rofi menus
corner_radius = 5

background = "#1d2021"
foreground = "#d5c4a1"


# Grimwood palette; normal uses the red accent from the focused i3 border and rofi menus
[urgency_low]
default_icon = "~/.config/dunst/icons/low.svg"
frame_color = "#665c54"
highlight = "#a89984"
format = "<b><span foreground='#a89984'>%s</span></b>\n%b"


[urgency_normal]
default_icon = "~/.config/dunst/icons/normal.svg"
frame_color = "#962b1f"
highlight = "#962b1f"
format = "<b>%s</b>\n%b"


[urgency_critical]
default_icon = "~/.config/dunst/icons/critical.svg"
background = "#2a1d1c"
frame_color = "#fb4934"
highlight = "#fb4934"
format = "<b><span foreground='#fb4934'>%s</span></b>\n%b"


# Workspace sessions (rofi/scripts/sessions.sh): icons are in the text, one notification at a time
[sessions]
appname = Sessions
icon_position = off
set_stack_tag = sessions
timeout = 4
