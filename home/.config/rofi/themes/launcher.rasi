/** Rofi : App launcher (scripts/launcher.sh) **/

configuration {
    modi:                "drun";
    show-icons:          true;
    display-drun:        "󰀻  Apps";
    drun-display-format: "{name} [<span alpha='50%'>{generic}</span>]";
}

@import "~/.config/rofi/themes/shared.rasinc"

element      { children: [ "element-icon", "element-text" ]; }
element-icon { size: 22px; vertical-align: 0.5; }
